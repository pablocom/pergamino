      "boundElements": [],
      "updated": 1759754699519,
      "link": null,
      "locked": false,
      "text": "Requirements:\n- Register\n- Login\n- See a feed of posts from other users that you're following (start just with text limit to 250 characters)\n- Follow other users\n- Create posts\n\nFeatures:\n- User Management\n- Authentication\n- Network\n- Post Management\n\nNon functional Requirements:\n- 5M registered customers\n- 3 posts per day / user\n- 10% of users are active daily\n- No limit on amount of posts per user\n- Optimized for quickly rendering the feed",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements:\n- Register\n- Login\n- See a feed of posts from other users that you're following (start just with text limit to 250 characters)\n- Follow other users\n- Create posts\n\nFeatures:\n- User Management\n- Authentication\n- Network\n- Post Management\n\nNon functional Requirements:\n- 5M registered customers\n- 3 posts per day / user\n- 10% of users are active daily\n- No limit on amount of posts per user\n- Optimized for quickly rendering the feed",
      "autoResize": true,
      "lineHeight": 1.25
    },
