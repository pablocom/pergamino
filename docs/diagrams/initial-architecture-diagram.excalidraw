    {
      "id": "IaKV38FNpQ38uWWAo_hqy",
      "type": "text",
      "x": 10620,
      "y": -1160,
      "width": 418,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3F",
      "roundness": null,
      "seed": 1740629596,
      "version": 396,
      "versionNonce": 471305060,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1767619156238,
      "link": null,
      "locked": false,
      "text": "Functional requirements\n- User to user chat\n- Group chats\n- Send files to chats\n- Receive notifications\n- Confirmation of receipt and shipment\n- Send activity signals when writing\n- receive unread messages when offline\n- extra - Content moderation",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements\n- User to user chat\n- Group chats\n- Send files to chats\n- Receive notifications\n- Confirmation of receipt and shipment\n- Send activity signals when writing\n- receive unread messages when offline\n- extra - Content moderation",
      "autoResize": true,
      "lineHeight": 1.25
    },
