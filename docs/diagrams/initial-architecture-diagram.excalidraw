      "seed": 192346852,
      "version": 854,
      "versionNonce": 1538246236,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1767618396466,
      "link": null,
      "locked": false,
      "text": "The servers connect to Kafka using consumer groups \nto ensure only 1 certain server will handle all messages of a chat (no out of order issues)\nbecause message key = either UserPair or GroupName ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The servers connect to Kafka using consumer groups \nto ensure only 1 certain server will handle all messages of a chat (no out of order issues)\nbecause message key = either UserPair or GroupName ",
      "autoResize": true,
      "lineHeight": 1.25
    },
