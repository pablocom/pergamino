      "updated": 1767616079292,
      "link": null,
      "locked": false,
      "text": "When joining SSE/Socket call, send the last message id pulled, \nthen after connecting, push pending messages to the SSE/Socket immediately, \nthen deliver messages as they're received \n(buffer msg between join and last unread deliver, then merge the ones were not sent)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When joining SSE/Socket call, send the last message id pulled, \nthen after connecting, push pending messages to the SSE/Socket immediately, \nthen deliver messages as they're received \n(buffer msg between join and last unread deliver, then merge the ones were not sent)",
      "autoResize": true,
      "lineHeight": 1.25
    },
